     def status(self):
         require((os.getpid(), threading.get_ident()) == self._actor, 'borrowed_actor')
         return {'state':self._stage,'callerOwnsStores':True,'storesClosedByAdapter':False,
@@ -168,6 +177,8 @@ async def disconnect_borrowed(adapter):
