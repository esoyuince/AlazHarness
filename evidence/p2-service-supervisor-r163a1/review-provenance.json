  "resolvedFindings": [
    {
      "id": "R163-PROVENANCE-01",
      "category": "pre-effect epoch bound",
      "finding": "Previous epoch 2**63-1 was valid handoff data but rejected by ServiceChannel only after Popen, consuming an attempt for an already invalid next generation.",
      "resolution": "decode_launch rejects epoch exhaustion before namespace opening, slot reservation and Popen.",
      "source": "gateway_supervised_service.decode_launch",
      "tests": [
        "test_service_supervisor_r163a1.PlanContracts.test_epoch_exhaustion_is_known_before_namespace_and_spawn"
      ],
      "status": "resolved by author; final source and regression test inspected"
    },
    {
      "id": "R163-PROVENANCE-02",
      "category": "same actor before owner mutation",
      "finding": "A foreign-thread observe/close could enter the identity-failure catch and mark the original child UNKNOWN/blocked.",
      "resolution": "_observe checks the exact owner and volume.actor against owner.who before child-slot state access or mutation. Original-actor live identity loss still retains UNKNOWN.",
      "source": "gateway_supervised_service._actor and _observe",
      "tests": [
        "test_service_supervisor_r163a1.ActualChildPipes.test_other_actor_cannot_operate_original_child"
      ],
      "status": "resolved by author; final source and regression test inspected"
    },
    {
      "id": "R163-PROVENANCE-03",
      "category": "same actor and truthful partial-dispatch diagnostic",
      "observedSourceSha256": "623ab718998be187add6d28f93712f84ffc4b979341df7b696c4a0300ba98aef",
      "finding": "serve_one reset the dispatch marker before its actor check. A foreign thread could reset an in-flight mutation marker and change the view, allowing a later lost reply to be labelled as no dispatch.",
      "resolution": "serve_one and serve_forever enforce actor and reentrancy before reset/catch/loop. Finally restores only the serving flag; it does not clean up ownership.",
      "source": "service_control_server.ServiceControlServer.serve_one and serve_forever",
      "tests": [
        "test_service_control_server_r163a1.ServerTests.test_wrong_thread_cannot_reset_active_dispatch_or_change_ready_view",
        "test_service_control_server_r163a1.ServerTests.test_reentrant_main_thread_cannot_reset_mutation_dispatch_marker"
      ],
      "status": "resolved by author; final source and regression test inspected"
    }
  ],
  "openSourceFindings": [],
  "contractsReviewed": [
    {
      "contract": "Original owner and process custody",
      "assessment": "Exact ServiceVolumeSupervisor and original actor, worker and image pin references remain linked to fence/scope/loop binding and PID/startTicks. The child slot is reserved before Popen. The same returned Popen and ServiceChannel remain retained through spawn, identity or pipe uncertainty."
    },
    {
      "contract": "Frozen plan and fixed executable",
      "assessment": "Bounded canonical bytes detach caller objects. Typed ServiceStartup and profile/volume/export bindings are decoded before spawn. Executable, argv, environment, entry and passed namespace descriptor are fixed in reviewed code. The child checks direct parent, live root, namespace and cgroup before fixed R162 projection/exec."
    },
    {
      "contract": "Descriptor failures and UNKNOWN",
      "assessment": "The known namespace descriptor closes through finally. Post-spawn constructor or FD-close failure retains the same attempt/process without channel start, retry, child signalling, unmount or volume release. Observation cannot finish a partial input write."
    },
    {
      "contract": "Legacy admission and retirement",
      "assessment": "The old service-volume start body is byte-identical to the archived parent. begin adds one child slot; new methods delegate. stop/finish refuse every attempted service child, including clean child completion; an absent legacy slot continues through the unchanged original volume contract."
    },
    {
      "contract": "Private Unix endpoint",
      "assessment": "Explicit canonical short path, exact private parent/socket identity and mode, same-UID/GID SO_PEERCRED, one bind attempt, no existing path replacement/adoption/unlink. The original actor owns lifecycle dispatch."
    },
    {
      "contract": "Wire shape, EOF and bounds",
      "assessment": "Exact request/owner schema, bounded safe-integer owner fields, compact ASCII JSON, duplicate/noncanonical rejection, one newline plus request EOF before dispatch, bounded bytes and independent read/write deadlines match the unchanged Node client."
    },
    {
      "contract": "Owner precondition and replay",
      "assessment": "All expectedOwner fields and service ID are checked before status or mutation. Mutation IDs reserve before effects, have a fixed maximum and never evict. Same-ID replay observes; conflicts refuse; a second start never spawns. Pending or finished close can observe only the original channel."
    },
    {
      "contract": "Partial diagnostics",
      "assessment": "Dispatch is recorded before lifecycle calls; actor/reentrancy gates protect that record. Lost responses retain owner, request and child without retry or cancellation. Foreign exception text is not formatted; public diagnostics exclude raw request, credential and private-path contents."
    },
    {
      "contract": "Phase-three completion",
      "assessment": "Child final plus original exit zero and stdout/stderr EOF maps to outer DRAINING. Outer CLOSED and volumeUnmounted/fenceRemovedAfterCleanup/imageLeaseReleased are never asserted here."
    }
  ],
