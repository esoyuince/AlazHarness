{
  "findings": [
    {
      "code": "host_gate_d151_pin_mismatch",
      "detail": "Current host source lock rejects d151 api_server.py and api_server_runs.py. Review/integration qualification required; do not relabel old acceptance.",
      "severity": "integration_blocker"
    },
    {
      "code": "pruning_native_lookup",
      "detail": "RunIdempotencyStore.lookup uses BEGIN IMMEDIATE, retention mutation and stale terminal pruning. It is not a read-only observation API."
    },
    {
      "code": "native_get_can_write",
      "detail": "GET run canonical branch reads run_projection; fallback _durable_run_status can mark dead-owner replay interrupted and update_status. Default bearer avoids room retention extension, not stale-owner repair."
    },
    {
      "code": "readonly_recovery_binding",
      "detail": "Use authenticated scope and original host intent key/fingerprint in a mode=ro attached state/replay snapshot. Validate config inventory, selected intent, replay fingerprint and runId/status identity, epoch/data versions/path identities. No replay row is not permission to retry."
    },
    {
      "code": "canonical_scope_limit",
      "detail": "Replay binding can recover runId without proving canonical admission/result. Full canonical verification requires api principal/requestId/target, payload scope/digest/model/input, admission epoch/generation and native saved result. Expose separate verified flags."
    },
    {
      "code": "secret_command_closure_gap",
      "detail": "Native registry lazily imports built-in command source and logs a registration warning on failure. command.py exists in d151 source but is absent from both finite and retained manifests. Neither real model closure nor credential resolution is accepted."
    },
    {
      "code": "provider_route_scope",
      "detail": "Both direct execution upstream and broker route_fingerprint only accept explicit http://127.0.0.1:<port>/v1. No direct public-provider HTTPS route is currently accepted."
    },
    {
      "code": "budget_accounting",
      "detail": "Execution ledger commits call/token/cost exposure before physical dispatch. Broker may add separately trusted private budget reservation before upstream. Lost responses keep reservations; profile/principal totals are not per-run invoices."
    }
  ],
